+gboolean
+gst_droidcamsrc_dev_configure_recording_pool (GstDroidCamSrcDev * dev,
+    GstVideoInfo * info)
+{
+  GstCaps *caps;
+  GstCapsFeatures *features;
+  GstStructure *config;
+  GstBufferPool *pool;
+  guint size;
+
+  if (!dev->recording_queue) {
+    GST_WARNING ("Cannot configure recording pool without recording queue");
+    return FALSE;
