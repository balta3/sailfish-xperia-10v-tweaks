+  if (dev->video_pool) {
+    gst_buffer_pool_set_active (dev->video_pool, FALSE);
+    gst_object_unref (dev->video_pool);
+  }
+  dev->video_pool = pool;
+  g_rec_mutex_unlock (dev->lock);
+
+  gst_caps_unref (caps);
+  return TRUE;
+}
