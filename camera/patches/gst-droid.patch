+
+static bool
+gst_droidcamsrc_dev_recording_frame_available (void *user,
+    DroidMediaBuffer * buffer)
+{
+  GstDroidCamSrcDev *dev = (GstDroidCamSrcDev *) user;
+  GstBuffer *gst_buffer = NULL;
+  GstBuffer *metadata_buffer = NULL;
+  GstMemory *metadata_memory;
+  GstDroidCamSrcRecordingMetadata *recording;
+
+  if (dev->video_pool)
+    gst_buffer = gst_droid_buffer_pool_acquire_media_buffer (dev->video_pool,
+        buffer);
+
+  if (!gst_buffer) {
+    GST_WARNING ("Failed to acquire camera recording buffer");
+    return false;
+  }
+
+
+  /*
+   * Android >= 9 records through a BufferQueue.  The droid video encoder
+   * expects Android VideoNativeMetadata rather than the YUV payload itself.
+   * DroidMediaBuffer inherits ANativeWindowBuffer, so the buffer pointer is
+   * the ANWBuffer pointer required by the metadata ABI.
+   *
+   * Keep the queue GstBuffer referenced by the wrapped metadata memory.  It
+   * is returned to the camera queue only after the encoder releases the input
+   * GstBuffer.  n_fence_fd starts at -1; fence-aware recycling will be added
+   * in droidmedia once the basic ANW metadata path is proven.
+   */
+  recording = g_slice_new0 (GstDroidCamSrcRecordingMetadata);
+  recording->metadata.e_type = GST_DROID_VIDEO_METADATA_TYPE_ANW_BUFFER;
+  recording->metadata.p_buffer = buffer;
+  recording->metadata.n_fence_fd = -1;
+  recording->queue_buffer = gst_buffer;
+
+  metadata_buffer = gst_buffer_new ();
+  metadata_memory = gst_wrapped_memory_allocator_wrap (dev->wrap_allocator,
+      &recording->metadata, sizeof (recording->metadata),
+      (GFunc) gst_droidcamsrc_dev_release_recording_metadata, recording);
+  gst_buffer_insert_memory (metadata_buffer, 0, metadata_memory);
+
+  gst_droidcamsrc_timestamp (
+      GST_DROIDCAMSRC (GST_PAD_PARENT (dev->imgsrc->pad)), metadata_buffer);
+
+  g_mutex_lock (&dev->vid->lock);
+  GST_BUFFER_OFFSET (metadata_buffer) = dev->vid->video_frames;
+  GST_BUFFER_OFFSET_END (metadata_buffer) = ++dev->vid->video_frames;
+
+  if (!dev->vid->running) {
+    gst_buffer_unref (metadata_buffer);
+  } else {
+    g_mutex_lock (&dev->vidsrc->lock);
+    g_queue_push_tail (dev->vidsrc->queue, metadata_buffer);
+    g_cond_signal (&dev->vidsrc->cond);
+    g_mutex_unlock (&dev->vidsrc->lock);
+  }
+
+  g_cond_signal (&dev->vid->cond);
+  g_mutex_unlock (&dev->vid->lock);
+
+  return true;
+}
